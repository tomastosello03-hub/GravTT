# ==============================================================================
# GravTT - .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDEs & Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Logs & Diagnostics
*.log
*.bak

# Temporary Scratch Scripts & Output tests
scratch/
*_test.png
test_*.png
before_reset.png
after_reset.png
test_dual_axis.png

# Large Raw Datasets (> 50MB) - GitHub warning at 50MB, hard limit at 100MB
mdtsmt.csv
*.tif.aux.xml
